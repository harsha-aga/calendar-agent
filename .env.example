# From Google Cloud > Google Auth Platform > Clients (your "Web application" client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Matches docker-compose.yml. Change it if your Postgres is set up differently.
DATABASE_URL=postgresql+psycopg://postgres:dev@localhost:5432/calendar_agent

# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Where this app runs. The redirect URI http://localhost:3000/oauth/callback must be
# registered on your OAuth client in Google Cloud.
APP_BASE_URL=http://localhost:3000

# Your public HTTPS tunnel URL, e.g. https://abcd-1234.ngrok-free.app
# Leave empty to start in polling-only mode (no ngrok needed).
WEBHOOK_BASE_URL=

# Catch-up sync interval in seconds (safety net for missed webhooks).
RECONCILE_INTERVAL_SECONDS=300

# ---------- Step 2: scheduling engine ----------
USER_TIMEZONE=America/New_York
WORK_START=09:00
WORK_END=18:00
# 1 = Monday ... 7 = Sunday
WORK_DAYS=1,2,3,4,5

# ---------- Step 3: the agent ----------
# From console.anthropic.com > API Keys (starts with sk-ant-)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
